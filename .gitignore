icontact-pack/aivoice/*/.vo-*/
!icontact-pack/aivoice/delivery/*.mp4
icontact-pack/email/v*/
icontact-pack/email/.vo-*/
icontact-pack/email/v*.json
icontact-pack/academy/*-16x9/
icontact-pack/academy/*-9x16/
icontact-pack/academy/*-4x5/
